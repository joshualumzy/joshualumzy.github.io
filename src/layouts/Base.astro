---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import "../styles/global.css";
const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`.replace("//", "/")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Enable hidden-until-revealed state only if motion is allowed; fail open if the bundle never runs.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js");
        setTimeout(() => { if (!window.__motion) document.documentElement.classList.remove("js"); }, 4000);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
